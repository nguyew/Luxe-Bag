PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/luxebag
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=7d
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_PUBLIC_URL=https://f004.backblazeb2.com/file/your-bucket-name
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
EMAIL_VERIFICATION_SECRET=replace-with-a-long-random-secret
EMAIL_VERIFICATION_ENABLED=true
GMAIL_USER=your-gmail-address@gmail.com
# Generate an App Password in Google Account > Security > App passwords.
# Paste the 16-character code without spaces.
GMAIL_APP_PASSWORD=your-16-character-google-app-password
MAIL_FROM="LuxeBag <your-gmail-address@gmail.com>"
EMAIL_CODE_TTL_MINUTES=10

STRIPE_SECRET_KEY=
STRIPE_CURRENCY=vnd
PAYMENT_TIMEOUT_MINUTES=30
PAYMENT_CLEANUP_INTERVAL_MINUTES=5
STRIPE_WEBHOOK_SECRET=
EMAIL_VERIFICATION_ENABLED=true