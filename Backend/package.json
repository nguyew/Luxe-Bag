{
  "name": "luxebag-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Express API for LuxeBag",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
    "seed": "node scripts/seed-mongodb.js",
    "seed:reset": "node scripts/seed-mongodb.js --reset",
    "seed:migrate": "node scripts/seed-mongodb.js --migrate",
    "seed:feedbacks": "node scripts/seed-feedbacks.js",
    "migrate:verify-existing-users": "node scripts/mark-existing-users-verified.js",
    "migrate:product-images": "node scripts/migrate-product-images.js",
    "migrate:catalog-terms": "node scripts/migrate-catalog-terms.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.7.0",
    "mongoose": "^9.11.4",
    "morgan": "^1.12.1",
    "nodemailer": "^10.2.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "stripe": "^23.0.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  }
}
